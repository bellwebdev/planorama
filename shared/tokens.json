{
  "$description": "Planorama design tokens — single source of truth (spec §10). Generated into frontend/src/globals.css by frontend/scripts/generate-tokens.mjs; consumable by the native app later.",
  "color": {
    "brand": {
      "primary": "#1A6B58",
      "primary-strong": "#155949",
      "secondary": "#E8623E",
      "secondary-strong": "#CF552F"
    },
    "status": {
      "voting": "#B45309",
      "approved": "#1A6B58",
      "discarded": "#6B7280",
      "coinflip": "#7155B3"
    },
    "day": {
      "1": "#C2410C",
      "2": "#0E7490",
      "3": "#7C3AED",
      "4": "#BE185D",
      "5": "#15803D",
      "6": "#B45309",
      "7": "#4338CA"
    },
    "text": {
      "default": "#1C1B18",
      "muted": "#7A7167",
      "inverse": "#FFFFFF"
    },
    "surface": {
      "bg": "#F8F7F4",
      "raised": "#FFFFFF",
      "border": "rgba(28, 27, 24, 0.1)"
    },
    "feedback": {
      "error": "#B91C1C",
      "error-bg": "#FEF2F2",
      "error-border": "#FECACA",
      "success": "#15803D",
      "success-bg": "#F0FDF4",
      "success-border": "#BBF7D0"
    }
  },
  "space": {
    "1": "0.25rem",
    "2": "0.5rem",
    "3": "0.75rem",
    "4": "1rem",
    "5": "1.5rem",
    "6": "2rem",
    "7": "3rem"
  },
  "radius": {
    "sm": "0.25rem",
    "md": "0.5rem",
    "xl": "0.75rem",
    "lg": "1rem",
    "full": "9999px"
  },
  "font": {
    "family-base": "'Outfit', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
    "family-heading": "'Fraunces', serif",
    "family-mono": "'DM Mono', ui-monospace, 'SF Mono', Menlo, monospace",
    "size-caption": "0.875rem",
    "size-body": "1rem",
    "size-body-lg": "1.125rem",
    "size-h3": "1.75rem",
    "size-h2": "2.25rem",
    "size-h1": "3rem",
    "weight-normal": "400",
    "weight-medium": "500",
    "weight-semibold": "600",
    "weight-bold": "700"
  },
  "breakpoint": {
    "$comment": "min-width breakpoints (mobile-first, base = 360px). CSS custom properties cannot drive media queries; these are documentation plus native-app input.",
    "tablet": "600px",
    "desktop": "900px"
  }
}
