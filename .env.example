# Copy to .env (never commit .env). All secrets live here, server-side only.
#
# These same POSTGRES_* / JWT_SIGNING_KEY values are used two ways:
#   - docker compose interpolates them into the api/worker/db containers
#   - running `dotnet run` / `dotnet ef` locally (outside Docker) derives its
#     connection string and signing key from this file directly, via
#     Planorama.Core.Configuration.DotEnvLoader — nothing is hard-coded in
#     appsettings.Development.json. If this file (or these keys) is missing,
#     local runs fail fast rather than silently using a stale committed secret.
POSTGRES_DB=planorama
POSTGRES_USER=planorama
POSTGRES_PASSWORD=change-me

# HMAC key for JWT signing — minimum 32 chars, generate with: openssl rand -base64 48
JWT_SIGNING_KEY=

# Cloudflare Pages origin allowed by CORS (dev default: Vite)
FRONTEND_ORIGIN=http://localhost:5173

ASPNETCORE_ENVIRONMENT=Production

# Phase 1+: third-party providers (server-side only, never shipped to clients).
# Geoapify serves places, routing and geocoding on one 3,000-credit/day free tier.
GEOAPIFY_API_KEY=

# Email is sent from the worker via plain SMTP (MailKit) — provider-agnostic, works
# with any standard SMTP relay (Amazon SES, Brevo, etc.). Not Resend: their free tier
# caps at one verified domain, already used by an unrelated business's lead form.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=no-reply@planorama.family

# Phase 0: Google OAuth. ID-token verification only needs the client ID (checked
# as the token's audience) — no client secret involved, since the backend never
# does a server-side code exchange.
GOOGLE_OAUTH_CLIENT_ID=

# Phase 0: Cloudflare R2 (S3-compatible object storage) for avatar uploads. Create
# an R2 bucket and a scoped API token (Cloudflare dashboard → R2 → Manage API
# Tokens); AccountId is shown on the R2 overview page. Enable the bucket's public
# access (Public Development URL or a custom domain) to get PublicBaseUrl.
#
# Not read by Planorama.Core.Configuration.DotEnvLoader — only avatar upload needs
# these, and that endpoint isn't required for the rest of the API to boot/run
# locally via `dotnet run`. Use `docker compose up` (which interpolates these for
# free) to test avatar upload, or export the five R2_* vars directly in your shell
# for a local `dotnet run` session.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
